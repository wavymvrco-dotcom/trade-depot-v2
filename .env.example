# ── Required ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://user:pass@host:5432/tradedepot
# Long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# 32-byte key for encrypting API keys/passwords at rest (64 hex chars).
# Generate once and never change it, or saved credentials become unreadable:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
NODE_ENV=production
APP_URL=https://your-domain.com

# ── Market data ───────────────────────────────────────────────────────────────
# Candles for AI signals, backtests and correlation (twelvedata.com)
TWELVE_DATA_API_KEY=

# ── Optional: model overrides (users bring their own provider keys) ──────────
# ANTHROPIC_MODEL=claude-opus-5-5
# OPENAI_MODEL=gpt-4o
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_MODEL=llama-3.3-70b-versatile
# XAI_MODEL=grok-3
# PERPLEXITY_MODEL=sonar

# ── Optional: billing (Stripe) ────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# ── Optional: web push (npx web-push generate-vapid-keys) ────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:you@your-domain.com

# ── Optional: outgoing email (password reset, verification) ──────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Optional: one-time admin bootstrap (POST /api/admin/setup) ───────────────
ADMIN_SETUP_KEY=
